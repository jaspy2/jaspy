# Debian 10 (buster) / amd64 build of nexus for a legacy prod VM that cannot be
# upgraded. Produces glibc-2.28-linked jaspy-nexus + diesel binaries.
#
# This is the MANUAL build path (build/build-debian10.sh). The modern container
# image for Kubernetes is built from nexus/Dockerfile (bookworm) by CI and is
# unaffected by this file. Keep the two in sync when nexus's build steps change:
# the stages below mirror nexus/Dockerfile, differing only where buster forces
# it (apt sources, Rust via rustup, PostgreSQL 11 instead of 15).
#
# Why a separate buster build at all: glibc is forward- but not
# backward-compatible, so the bookworm binary (needs glibc 2.36) will not run on
# buster (glibc 2.28). Compiling on buster links against 2.28.

# Stage 1: build the React admin UI (embedded into the nexus binary via
# rust-embed). The output is platform-independent static assets, so this stage
# runs natively regardless of the --platform on the builder stage below.
FROM node:22-slim AS webbuilder

WORKDIR /usr/src/webui
COPY webui/package.json webui/package-lock.json ./
RUN npm ci
COPY webui ./
RUN npm run build

# Stage 2: build nexus on Debian 10 itself so the binary links buster's glibc.
FROM --platform=linux/amd64 debian:buster-slim AS builder

# Buster is EOL: its apt repositories moved to archive.debian.org and the
# Release files are past their Valid-Until, so point apt there and disable the
# date check (otherwise apt-get update fails on this base image).
RUN printf 'deb http://archive.debian.org/debian buster main\ndeb http://archive.debian.org/debian-security buster/updates main\n' > /etc/apt/sources.list \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99no-check-valid-until

WORKDIR /usr/src/nexus

# Build + native-link deps. liboping-dev -> liboping0 (in-process pinger),
# libpq-dev -> libpq5 (diesel/postgres); both exist in buster and are the deb's
# runtime deps. postgresql provides the local server used to generate schema.rs.
RUN apt-get update && apt-get -y install --no-install-recommends \
      ca-certificates curl git build-essential pkg-config \
      libpq-dev liboping-dev libssl-dev \
      postgresql postgresql-client man \
 && rm -rf /var/lib/apt/lists/*

RUN for man in $(seq 0 9); do mkdir -p /usr/share/man/man${man}; done

# The official Rust buster images were discontinued, so install current stable
# via rustup. The toolchain runs on buster but, crucially, the code it compiles
# links against buster's glibc. Channel matches rust-toolchain.toml (stable).
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal

# diesel_cli generates src/schema.rs (gitignored) and runs migrations in the
# deb's postinst; build it here so the shipped diesel is also a buster binary.
RUN cargo install diesel_cli --no-default-features --features "postgres"

COPY ./Cargo.toml ./Cargo.toml
COPY ./Cargo.lock ./Cargo.lock
COPY ./rust-toolchain.toml ./rust-toolchain.toml
COPY ./build.rs ./build.rs
COPY ./src ./src
COPY ./diesel.toml ./diesel.toml
COPY ./migrations ./migrations
COPY ./migrations_sqlite ./migrations_sqlite

# rust-embed compiles webui/dist into the release binary, so it must be present
# before cargo build.
COPY --from=webbuilder /usr/src/webui/dist ./webui/dist

# buster ships PostgreSQL 11 (bookworm has 15); start its default "main" cluster
# to generate src/schema.rs via diesel (diesel.toml writes it), matching the
# bookworm build.
RUN su -c 'pg_ctlcluster 11 main start && createuser root && createdb root -O root' postgres \
 && diesel --database-url postgresql:///root migration run \
 && diesel --database-url postgresql:///root print-schema

RUN cat /usr/src/nexus/src/schema.rs
RUN cargo build --release

# build/build-debian10.sh runs this CMD to extract the buster artifacts; the
# build never reaches a runtime stage (there is none — the container image comes
# from nexus/Dockerfile).
CMD cp -a target/release/jaspy-nexus /output/jaspy-nexus \
 && cp -a /usr/local/cargo/bin/diesel /output/diesel \
 && cp -a migrations /output/migrations \
 && cp -a migrations_sqlite /output/migrations_sqlite

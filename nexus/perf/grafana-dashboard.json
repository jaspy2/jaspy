          "legendFormat": "unresponsive/s",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Poll iteration time \u2014 mean & peak",
      "description": "Mean per-iteration wall time (windowed) and the lifetime peak high-water mark. Dashed line marks a 10 s budget reference.",

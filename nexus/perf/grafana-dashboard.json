    {
      "id": 9,
      "type": "stat",
      "title": "Session opens/s",
      "description": "Embedded SNMP session (UDP socket) opens per second \u2014 the file-descriptor pressure canary in embedded mode. Should track the query rate and plateau, not grow unbounded.",

[Unit]
Description=jaspy-nexus
After=network.target postgresql.service

[Service]
# The embedded SNMP client opens a UDP socket per session; polling the full
# fleet concurrently bursts well past the 1024 default soft limit and drops
# polls with "Too many open files". Raise it (hard cap is far higher).
LimitNOFILE=65536
Type=simple
User=jaspy
Group=jaspy
# CAP_NET_RAW is required by the in-process pinger collector (raw ICMP sockets),
# which was formerly the standalone jaspy-pinger service. CAP_NET_BIND_SERVICE
# lets the embedded trap receiver bind UDP/162 (harmless when unused).
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
Environment=JASPY_DB_URL=postgresql:///jaspy
Environment=JASPY_MQTT_SERVER=127.0.0.1
# nexus serves the web admin UI and API on this one port (no reverse proxy
# needed). NOTE: the UI/API is unauthenticated until the auth phase lands;
# restrict to localhost again by setting 127.0.0.1 if that is a concern.
Environment=ROCKET_ADDRESS=0.0.0.0
Environment=ROCKET_PORT=8000
# SNMP access mode. Default "snmpbot" uses the external snmpbot sidecar below.
# For the embedded in-process SNMP client instead, set JASPY_SNMP_MODE=embedded
# (the snmpbot deb + service are then not needed) and, to replace snmptrapd,
# enable the embedded trap receiver:
#Environment=JASPY_SNMP_MODE=embedded
#Environment=JASPY_SNMP_MIB_DIR=/usr/share/jaspy/mibs
#Environment=JASPY_ENABLE_TRAP_RECEIVER=true
#Environment=JASPY_TRAP_BIND_ADDRESS=0.0.0.0:162
# In-process poller collector (formerly the standalone jaspy-poller service).
#Environment=JASPY_SNMPBOT_URL=http://127.0.0.1:8286/
Environment=JASPY_SNMP_MODE=embedded
Environment=JASPY_POLL_LOOP_MSECS=10000
# Megaexcel integration base URL. When set, the web UI shows a Megaexcel link in
# the nav and an "Open in Megaexcel" button on each device page (.../entity/<name>).
# Unset or comment out to hide the integration entirely.
Environment=JASPY_MEGAEXCEL_URL=https://megaexcel.arenius.fi
ExecStart=/usr/lib/jaspy/jaspy-nexus

[Install]
WantedBy=multi-user.target

